# This project ships as a static site and needs no environment
# variables to run. The variables below are only needed if/when you
# build the optional backend + admin panel described in
# docs/deployment.md (Phase 2).

# Database (MongoDB Atlas connection string)
MONGODB_URI=

# Admin authentication
ADMIN_JWT_SECRET=
ADMIN_EMAIL=

# Payment gateway (only if you connect one later — never required for
# plain UPI deep links, which need no secret key)
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
